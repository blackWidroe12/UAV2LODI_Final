# UAV2LoD1-ZW Backend Environment Variables
# Copy this file to .env and customize as needed

# Application
APP_NAME="UAV2LoD1-ZW Backend"
APP_VERSION="1.0.0"
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# Data Storage
DATA_ROOT=/data/uav2lod1
# DATA_ROOT=./data  # For local development

# Database
DATABASE_URL=sqlite+aiosqlite:///./uav2lod1.db

# Security (CHANGE THESE IN PRODUCTION!)
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days

# CORS Origins (comma-separated)
# CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Pipeline Defaults
DEFAULT_CRS=EPSG:32736
DEFAULT_GSD=0.05
DEFAULT_ENGINE=odm

# Thumbnail Settings
# THUMBNAIL_SIZE=(256,256)
# THUMBNAIL_QUALITY=85
